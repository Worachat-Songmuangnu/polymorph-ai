# Only the product and its results are published.
# Everything else (data collection, cloud setup, raw training data,
# internal notes) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/polymorph_ai/
!/tests/
!/examples/
!/dataset/
!/ml_notebooks/
!/brochure/
/examples/usecases.py
/ml_notebooks/figures/
/ml_notebooks/mlflow/mlflow.db
/ml_notebooks/mlflow/artifacts/
/ml_notebooks/results/


__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
